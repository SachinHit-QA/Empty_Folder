<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="main.listeners.ExtentTestNGListener"/>
    </listeners>

    <test name="Functional Tests">
        <packages>
            <package name="test.cases.*"/>
        </packages>
    </test>
</suite>